# Port the API listens on
PORT=4000

# PostgreSQL connection string. Leave empty to use the built-in in-memory demo database.
DATABASE_URL=
# DATABASE_URL=postgres://ecom:ecom@localhost:5432/ecom

# Secret used to sign login tokens (at least 32 characters). Required in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:3000

# Admin account created by the seed step (change these for any shared environment)
ADMIN_EMAIL=admin@ecom.dev
ADMIN_PASSWORD=Admin@12345
